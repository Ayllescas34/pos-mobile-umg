<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pos_fondo"
    android:orientation="vertical">

    <include layout="@layout/encabezado" />

    <include layout="@layout/estado" />

    <ScrollView
        android:id="@+id/desplazamiento"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                style="@style/Pos.Tarjeta">

                <TextView
                    android:id="@+id/txtSeleccion"
                    style="@style/Pos.TituloTarjeta"
                    android:text="Nueva sucursal" />

                <TextView
                    style="@style/Pos.Etiqueta"
                    android:text="Nombre" />

                <EditText
                    android:id="@+id/txtNombre"
                    style="@style/Pos.Campo"
                    android:importantForAutofill="no"
                    android:inputType="textCapWords"
                    android:maxLength="100" />

                <TextView
                    style="@style/Pos.Etiqueta"
                    android:text="Dirección (opcional)" />

                <EditText
                    android:id="@+id/txtDireccion"
                    style="@style/Pos.Campo"
                    android:importantForAutofill="no"
                    android:inputType="textPostalAddress|textMultiLine" />

                <TextView
                    style="@style/Pos.Etiqueta"
                    android:text="Teléfono (opcional)" />

                <EditText
                    android:id="@+id/txtTelefono"
                    style="@style/Pos.Campo"
                    android:importantForAutofill="no"
                    android:inputType="phone"
                    android:maxLength="20" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNuevo"
                        style="@style/Pos.Boton.Secundario"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Nuevo" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGuardar"
                        style="@style/Pos.Boton.Exito"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Guardar" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="0dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnActualizar"
                        style="@style/Pos.Boton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Actualizar" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEliminar"
                        style="@style/Pos.Boton.Peligro"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Eliminar" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/Pos.Tarjeta">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Listado"
                        android:textColor="@color/pos_texto"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnListar"
                        style="@style/Pos.Boton.Secundario"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:paddingHorizontal="14dp"
                        android:text="Recargar"
                        android:textSize="13sp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/txtBuscar"
                    style="@style/Pos.Campo"
                    android:drawablePadding="8dp"
                    android:drawableStart="@drawable/ic_buscar"
                    android:hint="Buscar por nombre o ID..."
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text" />

                <LinearLayout
                    android:id="@+id/listaSucursales"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
