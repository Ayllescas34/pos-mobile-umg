<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pos_fondo"
    android:orientation="vertical">

    <include layout="@layout/encabezado" />

    <include layout="@layout/estado" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabsVenta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/pos_tarjeta"
        app:tabIndicatorColor="@color/pos_principal"
        app:tabIndicatorFullWidth="true"
        app:tabMode="fixed"
        app:tabRippleColor="@color/pos_seleccion"
        app:tabSelectedTextColor="@color/pos_principal"
        app:tabTextColor="@color/pos_texto_secundario" />

    <ScrollView
        android:id="@+id/desplazamiento"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/panelRegistro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    style="@style/Pos.Tarjeta">

                    <TextView
                        style="@style/Pos.TituloTarjeta"
                        android:text="Datos de la venta" />

                    <TextView
                        style="@style/Pos.Etiqueta"
                        android:text="Cliente" />

                    <Spinner
                        android:id="@+id/spCliente"
                        style="@style/Pos.Lista" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Pos.Etiqueta"
                                android:text="Vendedor" />

                            <Spinner
                                android:id="@+id/spVendedor"
                                style="@style/Pos.Lista" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Pos.Etiqueta"
                                android:text="Cajero" />

                            <Spinner
                                android:id="@+id/spCajero"
                                style="@style/Pos.Lista" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Pos.Etiqueta"
                                android:text="Sucursal" />

                            <Spinner
                                android:id="@+id/spSucursal"
                                style="@style/Pos.Lista" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Pos.Etiqueta"
                                android:text="Método de pago" />

                            <Spinner
                                android:id="@+id/spMetodoPago"
                                style="@style/Pos.Lista" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    style="@style/Pos.Tarjeta">

                    <TextView
                        style="@style/Pos.TituloTarjeta"
                        android:text="Productos de la venta" />

                    <TextView
                        style="@style/Pos.Etiqueta"
                        android:text="Producto" />

                    <Spinner
                        android:id="@+id/spProducto"
                        style="@style/Pos.Lista" />

                    <TextView
                        android:id="@+id/txtInfoProducto"
                        style="@style/Pos.Ayuda"
                        android:layout_marginTop="-6dp"
                        android:layout_marginBottom="10dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Pos.Etiqueta"
                                android:text="Cantidad" />

                            <EditText
                                android:id="@+id/txtCantidad"
                                style="@style/Pos.Campo"
                                android:importantForAutofill="no"
                                android:inputType="number" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Pos.Etiqueta"
                                android:text="Precio (Q)" />

                            <EditText
                                android:id="@+id/txtPrecio"
                                style="@style/Pos.Campo"
                                android:importantForAutofill="no"
                                android:inputType="numberDecimal" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Pos.Etiqueta"
                                android:text="Subtotal (Q)" />

                            <EditText
                                android:id="@+id/txtSubtotal"
                                style="@style/Pos.Campo.Lectura"
                                android:importantForAutofill="no"
                                android:inputType="none" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAgregar"
                        style="@style/Pos.Boton"
                        android:layout_width="match_parent"
                        android:layout_marginBottom="12dp"
                        android:text="Agregar al carrito" />

                    <TextView
                        style="@style/Pos.Etiqueta"
                        android:text="Carrito (toca una línea para quitarla)" />

                    <LinearLayout
                        android:id="@+id/listaCarrito"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtArticulos"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/pos_secundario"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:text="TOTAL"
                            android:textColor="@color/pos_secundario"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/pos_principal"
                            android:textSize="26sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="0dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnNuevaVenta"
                            style="@style/Pos.Boton.Secundario"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="Nueva venta" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRegistrar"
                            style="@style/Pos.Boton.Exito"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="Guardar venta" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/panelConsulta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/panelDetalle"
                    style="@style/Pos.Tarjeta"
                    android:visibility="gone">

                    <TextView
                        style="@style/Pos.TituloTarjeta"
                        android:text="Detalle de la venta" />

                    <TextView
                        android:id="@+id/txtDetalleVenta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/pos_texto"
                        android:textSize="14sp" />

                    <TextView
                        style="@style/Pos.Etiqueta"
                        android:text="Productos (toca uno para quitarlo y devolver stock)" />

                    <LinearLayout
                        android:id="@+id/listaDetalles"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:orientation="vertical" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAgregarAVenta"
                        style="@style/Pos.Boton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:minHeight="46dp"
                        android:text="Agregar producto seleccionado" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="0dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCerrarDetalle"
                            style="@style/Pos.Boton.Secundario"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="Cerrar" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAnularVenta"
                            style="@style/Pos.Boton.Peligro"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="Eliminar venta" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    style="@style/Pos.Tarjeta">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Ventas registradas"
                            android:textColor="@color/pos_texto"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnListarVentas"
                            style="@style/Pos.Boton.Secundario"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:paddingHorizontal="14dp"
                            android:text="Recargar"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/txtBuscarVentas"
                        style="@style/Pos.Campo"
                        android:drawablePadding="8dp"
                        android:drawableStart="@drawable/ic_buscar"
                        android:hint="Buscar por cliente, sucursal, fecha..."
                        android:imeOptions="actionSearch"
                        android:importantForAutofill="no"
                        android:inputType="text" />

                    <LinearLayout
                        android:id="@+id/listaVentas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
