<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:text="Punto de venta"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtBienvenida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnMenuVentas"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="8dp"
            android:text="Ventas"
            android:textSize="17sp" />

        <Button
            android:id="@+id/btnMenuClientes"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="8dp"
            android:text="Clientes"
            android:textSize="17sp" />

        <Button
            android:id="@+id/btnMenuProductos"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="8dp"
            android:text="Productos"
            android:textSize="17sp" />

        <Button
            android:id="@+id/btnMenuCategorias"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="8dp"
            android:text="Categorías"
            android:textSize="17sp" />

        <Button
            android:id="@+id/btnMenuSucursales"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="8dp"
            android:text="Sucursales"
            android:textSize="17sp" />

        <Button
            android:id="@+id/btnMenuUsuarios"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="24dp"
            android:text="Usuarios (vendedores y cajeros)"
            android:textSize="17sp" />

        <Button
            android:id="@+id/btnMenuCerrarSesion"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cerrar sesión" />

    </LinearLayout>

</ScrollView>
