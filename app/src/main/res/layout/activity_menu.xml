<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pos_fondo"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/encabezado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/pos_lateral"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Punto de Venta"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtUsuarioMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/pos_lateral_texto"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnMenuCerrarSesion"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cerrar sesión"
            android:src="@drawable/ic_salir" />
    </LinearLayout>

    <include layout="@layout/estado" />

    <ScrollView
        android:id="@+id/desplazamiento"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/txtBienvenida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/pos_texto"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                style="@style/Pos.Ayuda"
                android:layout_marginBottom="14dp"
                android:text="Este es el resumen de tu negocio."
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/Pos.Tarjeta"
                    android:layout_width="0dp"
                    android:layout_marginBottom="10dp"
                    android:layout_weight="1"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <TextView
                        style="@style/Pos.Etiqueta"
                        android:text="Ventas" />

                    <TextView
                        android:id="@+id/lblVentas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:text="—"
                        android:textColor="@color/pos_principal"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/lblVentasAyuda"
                        style="@style/Pos.Ayuda"
                        android:text="registradas" />
                </LinearLayout>

                <LinearLayout
                    style="@style/Pos.Tarjeta"
                    android:layout_width="0dp"
                    android:layout_marginBottom="10dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <TextView
                        style="@style/Pos.Etiqueta"
                        android:text="Ingresos" />

                    <TextView
                        android:id="@+id/lblIngresos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:text="—"
                        android:textColor="@color/pos_principal"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/lblIngresosAyuda"
                        style="@style/Pos.Ayuda"
                        android:text="acumulados" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/Pos.Tarjeta"
                    android:layout_width="0dp"
                    android:layout_marginBottom="10dp"
                    android:layout_weight="1"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <TextView
                        style="@style/Pos.Etiqueta"
                        android:text="Productos" />

                    <TextView
                        android:id="@+id/lblProductos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:text="—"
                        android:textColor="@color/pos_principal"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/lblProductosAyuda"
                        style="@style/Pos.Ayuda"
                        android:text=" " />
                </LinearLayout>

                <LinearLayout
                    style="@style/Pos.Tarjeta"
                    android:layout_width="0dp"
                    android:layout_marginBottom="10dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <TextView
                        style="@style/Pos.Etiqueta"
                        android:text="Clientes" />

                    <TextView
                        android:id="@+id/lblClientes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:text="—"
                        android:textColor="@color/pos_principal"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/lblClientesAyuda"
                        style="@style/Pos.Ayuda"
                        android:text="registrados" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/Pos.TituloTarjeta"
                android:layout_marginTop="8dp"
                android:text="Accesos rápidos" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnMenuVentas"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_acceso"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginBottom="8dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_ventas" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ventas"
                        android:textColor="@color/pos_texto"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/Pos.Ayuda"
                        android:text="Registra y consulta" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnMenuClientes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_acceso"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginBottom="8dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_clientes" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Clientes"
                        android:textColor="@color/pos_texto"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/Pos.Ayuda"
                        android:text="Datos de clientes" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnMenuProductos"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_acceso"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginBottom="8dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_productos" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Productos"
                        android:textColor="@color/pos_texto"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/Pos.Ayuda"
                        android:text="Inventario y precios" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnMenuCategorias"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_acceso"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginBottom="8dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_categorias" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Categorías"
                        android:textColor="@color/pos_texto"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/Pos.Ayuda"
                        android:text="Organiza productos" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnMenuSucursales"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_acceso"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginBottom="8dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_sucursales" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sucursales"
                        android:textColor="@color/pos_texto"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/Pos.Ayuda"
                        android:text="Puntos de venta" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnMenuUsuarios"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_acceso"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginBottom="8dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_usuarios" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Usuarios"
                        android:textColor="@color/pos_texto"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/Pos.Ayuda"
                        android:text="Vendedores y cajeros" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
